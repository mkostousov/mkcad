{
  "id": "SK-04", "title": "SK-01, W=0 / W=-10 -> INVALID_VALUE, document and undo depth unchanged (API = GUI)", "ref": ["F39", "F17", "F18", "S-11"],
  "steps": [
    {"op": "point", "name": "O", "at": [0, 0]},
    {"op": "constrain", "c": {"type": "fix", "entity": "O"}},
    {"op": "rectangle", "name": "R", "p1": [0, 0], "p2": [31, 17]},
    {"op": "constrain", "c": {"type": "coincident", "a": "O", "b": "R.p0"}},
    {"op": "constrain", "name": "W", "c": {"type": "distance", "a": "R.p0", "b": "R.p1", "value": 40}},
    {"op": "constrain", "name": "H", "c": {"type": "distance", "a": "R.p1", "b": "R.p2", "value": 20}, "expect": {"undo_depth": 6}},
    {"op": "set", "dim": "W", "value": 0, "expect": {"error": "SKETCH.DIM.INVALID_VALUE", "unchanged": true}},
    {"op": "set", "dim": "W", "value": -10, "expect": {"error": "SKETCH.DIM.INVALID_VALUE", "unchanged": true}},
    {"op": "constrain", "c": {"type": "distance", "a": "R.p0", "b": "R.p2", "value": 0}, "expect": {"error": "SKETCH.DIM.INVALID_VALUE", "unchanged": true}},
    {"op": "circle", "name": "C", "center": [100, 0], "r": 5},
    {"op": "constrain", "c": {"type": "radius", "curve": "C", "value": -1}, "expect": {"error": "SKETCH.DIM.INVALID_VALUE", "unchanged": true}},
    {"op": "circle", "center": [100, 0], "r": 0, "expect": {"error": "SKETCH.DIM.INVALID_VALUE", "unchanged": true}},
    {"op": "check", "expect": {"points": {"R.p2": [40, 20]}, "undo_depth": 7}}
  ]
}
